# Keep directory markers; never commit datasets or generated results
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/results/figures/*
!/results/figures/.gitkeep
/results/metrics/*
!/results/metrics/.gitkeep
*.joblib
*.pkl
